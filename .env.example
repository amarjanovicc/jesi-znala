# Primjer postavki. Prave vrijednosti NE idu u Git nego u Vercel:
#   npx vercel env add IME production      (pita za vrijednost)
# ili Vercel dashboard -> projekt -> Settings -> Environment Variables.

# --- obavezno za admin (/admin.html) ---
ADMIN_PASSWORD=

# --- baza: dodaje se sama kad u Vercelu povežeš Upstash Redis (Storage) ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- obavijesti: dovoljan je jedan kanal ---
# ntfy (bez računa): instaliraj aplikaciju ntfy i pretplati se na isti tajni naziv teme
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# Telegram (neobavezno)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# E-pošta preko Resenda (neobavezno)
# RESEND_API_KEY=
# NOTIFY_EMAIL=
